#!/bin/bash
# Claude Code Notification hook.
# Notifications fire for both task-completion alerts AND mid-task permission
# requests. Only turn red for the latter: if Stop already wrote "ready" first,
# this is a completion alert and we leave the green light alone.

cat > /dev/null  # drain stdin

STATE_FILE="$HOME/.local/share/claude-traffic-light/status"

current=$(cat "$STATE_FILE" 2>/dev/null)
if [ "$current" = "ready" ]; then
    exit 0  # completion notification after a finished response — don't override green
fi

printf 'waiting' > "$STATE_FILE"
